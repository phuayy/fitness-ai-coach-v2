APP_ENV=local
LOG_LEVEL=INFO
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_MINUTES=10080
DATABASE_URL=sqlite:///./fitness_ai.sqlite3

# Comma-separated format is accepted:
FRONTEND_ORIGINS=http://localhost:5173

# JSON array format is also accepted, especially for multiple deployed domains:
# FRONTEND_ORIGINS=["http://localhost:5173","https://your-vercel-app.vercel.app"]
